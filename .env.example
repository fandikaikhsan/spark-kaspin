# POS API (server-only)
BASE_URL=https://your-pos.example.com
TOKEN=initial-access-token
REFRESH_TOKEN=initial-refresh-token
REFRESH_TIME=3
POS_UTC_OFFSET=+07:00
POS_TIME_ZONE=Asia/Jakarta

# Supabase (server-only service role; never expose this key in the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Telegram bot webhook and allow-list (used by the Telegram Lambda)
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace_with_letters_numbers_dashes_or_underscores
TELEGRAM_ALLOWED_CHAT_ID=123456789
