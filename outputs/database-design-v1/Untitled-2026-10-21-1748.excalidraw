      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Receiving uses the same pack conversions\nas stock opname and recipe entry.",
      "originalText": "Receiving uses the same pack conversions\nas stock opname and recipe entry.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
