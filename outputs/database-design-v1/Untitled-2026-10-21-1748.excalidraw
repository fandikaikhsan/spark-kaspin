    },
    {
      "id": "text-0775",
      "type": "text",
      "x": 3530,
      "y": 3815,
      "width": 505,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#147989",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 736767946,
      "version": 8,
      "versionNonce": 530846684,
      "index": "bAu",
      "isDeleted": false,
      "groupIds": [
        "note-group-0773"
      ],
      "frameId": "frame-0649",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Decisions still open - do not hide these in the engine",
      "originalText": "Decisions still open - do not hide these in the engine",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0776",
      "type": "text",
      "x": 3530,
      "y": 3853,
      "width": 645.984375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 367261724,
      "version": 8,
      "versionNonce": 725395428,
      "index": "bAv",
      "isDeleted": false,
      "groupIds": [
        "note-group-0773"
      ],
      "frameId": "frame-0649",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "VALUATION: one common reference cost values usage variance.\nAccounting COGS with FIFO / weighted-average purchase layers is a separate policy.",
      "originalText": "VALUATION: one common reference cost values usage variance.\nAccounting COGS with FIFO / weighted-average purchase layers is a separate policy.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0777",
      "type": "text",
      "x": 3530,
      "y": 3912,
      "width": 585,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 440149156,
      "version": 8,
      "versionNonce": 841824348,
      "index": "bAw",
      "isDeleted": false,
      "groupIds": [
        "note-group-0773"
      ],
      "frameId": "frame-0649",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "COVERAGE: missing counts, unknown quantities, recipes or unmapped sales\nproduce partial/blocked results. Missing data never becomes a healthy zero.",
      "originalText": "COVERAGE: missing counts, unknown quantities, recipes or unmapped sales\nproduce partial/blocked results. Missing data never becomes a healthy zero.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0778",
      "type": "text",
      "x": 3530,
      "y": 3971,
      "width": 615,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 24486281,
      "version": 8,
      "versionNonce": 1017514852,
      "index": "bAx",
      "isDeleted": false,
      "groupIds": [
        "note-group-0773"
      ],
      "frameId": "frame-0649",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "PREPARED STOCK: identify raw vs prepared packs and confirm usable yields.\nStandard-recipe equivalents are estimates unless actual batches are represented.",
      "originalText": "PREPARED STOCK: identify raw vs prepared packs and confirm usable yields.\nStandard-recipe equivalents are estimates unless actual batches are represented.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0779",
      "type": "text",
      "x": 3530,
      "y": 4030,
      "width": 640.984375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 974699554,
      "version": 8,
      "versionNonce": 1360907484,
      "index": "bAy",
      "isDeleted": false,
      "groupIds": [
        "note-group-0773"
      ],
      "frameId": "frame-0649",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "HISTORY: snapshot input sales, resolved recipe/cost versions and included receipts.\nA rerun creates a new run; later source updates must not silently rewrite old results.",
      "originalText": "HISTORY: snapshot input sales, resolved recipe/cost versions and included receipts.\nA rerun creates a new run; later source updates must not silently rewrite old results.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0780",
      "type": "text",
      "x": 2250,
      "y": 4490,
      "width": 275,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#718096",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
