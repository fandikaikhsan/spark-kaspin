      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "1.5 jerrycans: decimal qty + defined capacity.\nOpen / variable-weight packs: weigh or estimate.",
      "originalText": "1.5 jerrycans: decimal qty + defined capacity.\nOpen / variable-weight packs: weigh or estimate.",
      "fontSize": 17,
      "baseFontSize": null,
