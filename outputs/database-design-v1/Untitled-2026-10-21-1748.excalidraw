    },
    {
      "id": "text-0640",
      "type": "text",
      "x": 2725,
      "y": 2853,
      "width": 310,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 646664863,
      "version": 8,
      "versionNonce": 521618660,
      "index": "b8o",
      "isDeleted": false,
      "groupIds": [
        "note-group-0637"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Purchased stock only in the first version.\nQuantities > 0; conversion factors > 0.",
      "originalText": "Purchased stock only in the first version.\nQuantities > 0; conversion factors > 0.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0641",
      "type": "text",
      "x": 2725,
      "y": 2912,
      "width": 409,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 453172787,
      "version": 8,
      "versionNonce": 1956047708,
      "index": "b8p",
      "isDeleted": false,
      "groupIds": [
        "note-group-0637"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Posted receipts are included once, by ID.\nRetain corrections/voids and recompute affected runs.",
      "originalText": "Posted receipts are included once, by ID.\nRetain corrections/voids and recompute affected runs.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0642",
      "type": "text",
      "x": 2725,
      "y": 2971,
      "width": 365,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 84765369,
      "version": 8,
      "versionNonce": 1965361252,
      "index": "b8q",
      "isDeleted": false,
      "groupIds": [
        "note-group-0637"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "line_cost records actual purchase cost if known.\nMissing cost is NULL, not an invented zero.",
      "originalText": "line_cost records actual purchase cost if known.\nMissing cost is NULL, not an invented zero.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
