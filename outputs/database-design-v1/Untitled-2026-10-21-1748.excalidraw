      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Later: purchasing and expenses",
      "originalText": "Later: purchasing and expenses",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0646",
      "type": "text",
      "x": 3650,
      "y": 2853,
      "width": 479,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 107116524,
      "version": 8,
      "versionNonce": 1538153444,
      "index": "b8t",
      "isDeleted": false,
      "groupIds": [
        "note-group-0643"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Purchase orders / purchase-order lines can link to receipt lines.\nSupplier records can replace the initial supplier text fields.",
      "originalText": "Purchase orders / purchase-order lines can link to receipt lines.\nSupplier records can replace the initial supplier text fields.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0647",
      "type": "text",
      "x": 3650,
      "y": 2912,
      "width": 551.96875,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 832466954,
      "version": 8,
      "versionNonce": 1105249372,
      "index": "b8u",
      "isDeleted": false,
      "groupIds": [
        "note-group-0643"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Expense/payment records track obligations and money paid.\nA receipt can exist without a purchase order, and is not proof of payment.",
      "originalText": "Expense/payment records track obligations and money paid.\nA receipt can exist without a purchase order, and is not proof of payment.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "text-0648",
      "type": "text",
      "x": 3650,
      "y": 2971,
      "width": 626,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 707680950,
      "version": 8,
      "versionNonce": 1556168548,
      "index": "b8v",
      "isDeleted": false,
      "groupIds": [
        "note-group-0643"
      ],
      "frameId": "frame-0551",
      "boundElements": [],
      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Additional stock movements (transfers, supplier returns, etc.) need explicit records\nbefore the simple opening + receiving - closing formula can cover those operations.",
      "originalText": "Additional stock movements (transfers, supplier returns, etc.) need explicit records\nbefore the simple opening + receiving - closing formula can cover those operations.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
