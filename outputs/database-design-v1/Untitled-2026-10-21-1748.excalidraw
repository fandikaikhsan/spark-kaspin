      "updated": 1792147614769,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Receiving rules",
      "originalText": "Receiving rules",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
