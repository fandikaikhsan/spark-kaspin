      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Apply selling price updates ITEMS.sales_price;\nthere is no second independently editable final price.",
      "originalText": "Apply selling price updates ITEMS.sales_price;\nthere is no second independently editable final price.",
      "fontSize": 17,
