      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "At least one ingredient before publication.\nIngredient quantities and usable yield > 0.",
      "originalText": "At least one ingredient before publication.\nIngredient quantities and usable yield > 0.",
      "fontSize": 17,
      "baseFontSize": null,
