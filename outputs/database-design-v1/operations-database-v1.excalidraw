      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Look up ITEMS by store_id + item_code.\nDo not rename incoming POS codes.",
      "originalText": "Look up ITEMS by store_id + item_code.\nDo not rename incoming POS codes.",
      "fontSize": 17,
      "baseFontSize": null,
