      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "10 small packs + 1 large pack:\ntwo entries under the same stock-count line.",
      "originalText": "10 small packs + 1 large pack:\ntwo entries under the same stock-count line.",
