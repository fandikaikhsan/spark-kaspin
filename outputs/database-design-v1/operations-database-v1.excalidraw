      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "No enforced item FK on incoming sale lines:\nunmapped new products must not stop ingestion.",
      "originalText": "No enforced item FK on incoming sale lines:\nunmapped new products must not stop ingestion.",
      "fontSize": 17,
