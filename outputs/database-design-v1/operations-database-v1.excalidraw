      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Purchased and prepared components allowed.\nReject direct and indirect recipe cycles.",
      "originalText": "Purchased and prepared components allowed.\nReject direct and indirect recipe cycles.",
