      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "as_of_at is the actual stock cutoff, not the form-save time. Include all store areas.\nPrepared-stock entries reference the recipe represented by the remaining stock.",
