      "isDeleted": false,
      "groupIds": [
        "note-group-0766"
      ],
      "frameId": "frame-0649",
      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Calculation basis",
      "originalText": "Calculation basis",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0769",
      "type": "text",
      "x": 2270,
      "y": 3853,
      "width": 527.0,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 139257277,
      "version": 1,
      "versionNonce": 821296481,
      "index": null,
      "isDeleted": false,
      "groupIds": [
        "note-group-0766"
      ],
      "frameId": "frame-0649",
      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Actual usage = opening + receiving - closing.\nTheoretical usage = confirmed net sales x expanded recipe quantities.",
      "originalText": "Actual usage = opening + receiving - closing.\nTheoretical usage = confirmed net sales x expanded recipe quantities.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0770",
      "type": "text",
      "x": 2270,
      "y": 3912,
      "width": 503.0,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 344470434,
      "version": 1,
      "versionNonce": 637415042,
      "index": null,
      "isDeleted": false,
      "groupIds": [
        "note-group-0766"
      ],
      "frameId": "frame-0649",
      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Delta COGS = actual usage cost - theoretical usage cost.\nResults are by purchased leaf item: raw material or resale product.",
      "originalText": "Delta COGS = actual usage cost - theoretical usage cost.\nResults are by purchased leaf item: raw material or resale product.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0771",
      "type": "text",
      "x": 2270,
      "y": 3971,
      "width": 533.0,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 294660452,
      "version": 1,
      "versionNonce": 909540291,
      "index": null,
      "isDeleted": false,
      "groupIds": [
        "note-group-0766"
      ],
      "frameId": "frame-0649",
      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Remaining prepared stock contributes raw-material equivalents\nto opening/closing stock; use the recipes represented by those entries.",
      "originalText": "Remaining prepared stock contributes raw-material equivalents\nto opening/closing stock; use the recipes represented by those entries.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-0772",
      "type": "text",
      "x": 2270,
      "y": 4030,
      "width": 501.0,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#63758b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 80181669,
      "version": 1,
      "versionNonce": 710386063,
      "index": null,
      "isDeleted": false,
      "groupIds": [
        "note-group-0766"
      ],
      "frameId": "frame-0649",
      "boundElements": null,
      "updated": 1792142970363,
      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "Keep monetary recipe allowances out of physical usage quantities.",
      "originalText": "Keep monetary recipe allowances out of physical usage quantities.",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rectangle-0774",
      "type": "rectangle",
      "x": 3510,
      "y": 3800,
      "width": 1445,
      "height": 291,
      "angle": 0,
      "strokeColor": "#cffafe",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
