      "created": 1792142970363,
      "link": null,
      "locked": false,
      "text": "One POS quantity unit maps to an item unit.\nThat conversion produces base-unit consumption.",
      "originalText": "One POS quantity unit maps to an item unit.\nThat conversion produces base-unit consumption.",
