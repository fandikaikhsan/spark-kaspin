    {
      "id": "text-0768",
      "type": "text",
      "x": 2270,
      "y": 3815,
      "width": 168.0,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#147989",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 230823358,
      "version": 1,
      "versionNonce": 395211286,
